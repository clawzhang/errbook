# syntax=docker/dockerfile:1.7

# ============================================
# 超级优化版 Dockerfile（使用 pnpm）
# 预计镜像大小：120-150MB（从 320MB 减少 55-60%）
# ============================================

# ============================================
# 阶段 1: 基础镜像
# ============================================
FROM node:22-alpine AS base
WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production \
    PNPM_HOME="/pnpm" \
    PATH="$PNPM_HOME:$PATH"

RUN apk add --no-cache libc6-compat openssl && \
    corepack enable && \
    corepack prepare pnpm@latest --activate

# ============================================
# 阶段 2: 依赖安装（生产依赖）
# ============================================
FROM base AS deps

COPY package.json pnpm-lock.yaml* ./

# 使用 pnpm 安装生产依赖
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --prod --frozen-lockfile --ignore-scripts && \
    # 清理不必要的文件
    find /app/node_modules -name "*.md" -delete && \
    find /app/node_modules -name "*.ts" -not -name "*.d.ts" -delete && \
    find /app/node_modules -type d -name "test" -o -name "tests" -o -name "__tests__" | xargs rm -rf 2>/dev/null || true && \
    find /app/node_modules -name "*.spec.js" -o -name "*.test.js" -delete

# ============================================
# 阶段 3: 构建依赖
# ============================================
FROM base AS build-deps

RUN apk add --no-cache python3 make g++

COPY package.json pnpm-lock.yaml* ./

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# ============================================
# 阶段 4: 构建应用
# ============================================
FROM base AS builder

RUN apk add --no-cache python3 make g++

COPY --from=build-deps /app/node_modules ./node_modules
COPY . .

ENV DATABASE_URL=file:/app/data/dev.db \
    NODE_OPTIONS="--max-old-space-size=4096"

# 生成 Prisma Client 并构建
RUN npx prisma generate && \
    npm run build && \
    # 删除 source maps
    find .next -name "*.map" -delete 2>/dev/null || true && \
    # 优化 Prisma
    rm -rf node_modules/.prisma/client/libquery_engine-* 2>/dev/null || true && \
    find node_modules/.prisma/client -name "*.node" -not -name "*linux-musl*" -delete 2>/dev/null || true

# 准备运行产物：优先使用 standalone，缺失时回退到完整 .next 输出
RUN mkdir -p /tmp/app-output && \
    if [ -f ".next/standalone/server.js" ]; then \
        echo "✅ Using standalone output"; \
        cp -a .next/standalone/. /tmp/app-output/ && \
        mkdir -p /tmp/app-output/.next && \
        cp -a .next/static /tmp/app-output/.next/static && \
        cp -a public /tmp/app-output/public; \
    else \
        echo "⚠️  Standalone output not found, using full .next output"; \
        cp -a .next /tmp/app-output/.next && \
        cp -a public /tmp/app-output/public && \
        cp package.json /tmp/app-output/package.json; \
    fi && \
    if [ ! -f "/tmp/app-output/server.js" ] && [ ! -f "/tmp/app-output/.next/BUILD_ID" ]; then \
        echo "❌ Next.js runtime output is incomplete"; \
        find /tmp/app-output -maxdepth 2 -type f | sort; \
        exit 1; \
    fi

# ============================================
# 阶段 5: 生产运行镜像（极致优化）
# ============================================
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    DATABASE_URL=file:/app/data/dev.db \
    UPLOAD_DIR=/app/public/uploads

RUN apk add --no-cache openssl dumb-init && \
    addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs && \
    mkdir -p /app/data /app/public/uploads && \
    chown -R nextjs:nodejs /app

# 复制优化后的依赖
COPY --from=deps --chown=nextjs:nodejs /app/node_modules ./node_modules

# 复制构建产物（standalone 或完整 .next）
COPY --from=builder --chown=nextjs:nodejs /tmp/app-output ./

# 复制 Prisma
COPY --from=builder --chown=nextjs:nodejs /app/prisma.config.ts ./prisma.config.ts
COPY --from=builder --chown=nextjs:nodejs /app/prisma ./prisma

# 复制启动脚本
COPY --from=builder --chown=nextjs:nodejs /app/scripts/docker-entrypoint.sh ./scripts/docker-entrypoint.sh
RUN chmod +x ./scripts/docker-entrypoint.sh

USER nextjs

EXPOSE 3000

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["./scripts/docker-entrypoint.sh"]
