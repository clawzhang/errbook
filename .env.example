# 数据库配置
DATABASE_URL=file:./dev.db

# 认证配置
# 生产环境请使用足够长的随机字符串
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-a-long-random-secret

# NextAuth 外部访问地址
# 本地开发使用 http://localhost:3000
# 生产环境改为实际域名，如 https://yourdomain.com
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# 管理员邮箱
# 注册并登录该邮箱账号后，可在用户菜单进入用户管理并重置用户密码
ADMIN_EMAIL=admin@example.com

# 文件上传目录
UPLOAD_DIR=public/uploads

# API 密钥加密密钥（必需）
# 用于加密存储用户的 AI API 密钥，必须是 64 个十六进制字符（32 字节）
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ 警告：此密钥一旦设置不可更改，否则已加密的数据将无法解密
ENCRYPTION_KEY=replace-with-64-hex-characters-generated-by-command-above

# 日志级别（可选）
# 可选值：trace, debug, info, warn, error
LOG_LEVEL=info

# Node 环境（自动设置，无需手动配置）
# NODE_ENV=development
